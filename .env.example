# Explicit scratch Vault for development; never default to test fixtures.
OBSIDIAN_VAULT_PATH=/absolute/path/to/scratch-vault
TRACKER_RELATIVE_PATH=Life/HabitTracker
TRACKER_STATE_PATH=/absolute/path/to/tracker-state
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# Production: private Tailscale Serve origin and owner login are required.
# APP_ORIGIN=https://your-mac.your-tailnet.ts.net
# TAILSCALE_OWNER=you@example.com
