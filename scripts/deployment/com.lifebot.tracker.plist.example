<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.lifebot.tracker</string>
  <key>WorkingDirectory</key><string>ABSOLUTE_APP_DIRECTORY</string>
  <key>ProgramArguments</key><array>
    <string>ABSOLUTE_NODE_BINARY</string><string>--import</string><string>tsx</string>
    <string>--env-file=ABSOLUTE_APP_DIRECTORY/.env</string><string>app/server/main.ts</string>
  </array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>ABSOLUTE_LOG_DIRECTORY/tracker.log</string>
  <key>StandardErrorPath</key><string>ABSOLUTE_LOG_DIRECTORY/tracker-error.log</string>
</dict></plist>
