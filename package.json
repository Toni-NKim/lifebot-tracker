{
  "name": "lifebot-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env app/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file=.env app/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "vault:init": "tsx --env-file=.env scripts/init-vault.ts",
    "vault:validate": "tsx --env-file=.env scripts/validate-vault.ts",
    "index:rebuild": "tsx --env-file=.env scripts/rebuild-index.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@js-temporal/polyfill": "^0.5.1",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.104.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "pretendard": "1.3.9",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
